offset_top = 20.0
offset_right = -10.0
offset_bottom = 140.0
visible = false
theme_override_constants/separation = 10

[node name="DealerLabel" type="Label" parent="DealerPanel"]
text = "You are the dealer — pick a game:"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0, 0, 0, 1)

[node name="BtnRow" type="HBoxContainer" parent="DealerPanel"]
theme_override_constants/separation = 10

[node name="HoldemBtn" type="Button" parent="DealerPanel/BtnRow"]
