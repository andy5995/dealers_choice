# Path to the directory containing cert.pem and key.pem.
# Copy this file to .env and set CERTS_PATH for your platform.
# Use an absolute path — variable expansion is not supported here.
#
# Linux / macOS:
# CERTS_PATH=/home/yourname/.local/share/that-gd-poker-suite/nginx/certs
#
# Windows (use forward slashes):
# CERTS_PATH=C:/Users/YourName/AppData/Local/that-gd-poker-suite/nginx/certs

CERTS_PATH=
